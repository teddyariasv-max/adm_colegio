@page "/matriculas"
@inject adm_colegio_front.Services.Matricula_service matricula_service
@inject adm_colegio_front.Services.Persona_service persona_service
@inject adm_colegio_front.Services.Materia_service materia_service

<h3>Gestión de Matrículas y Calificaciones</h3>

@if (!string.IsNullOrEmpty(mensaje_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @mensaje_error
        <button type="button" class="btn-close" @onclick="() => mensaje_error = string.Empty"></button>
    </div>
}

@if (lista_matriculas == null)
{
    <p><em>Cargando matrículas...</em></p>
}
else
{
    <div class="card mb-4">
        <div class="card-header">Nueva Matrícula</div>
        <div class="card-body">
            <div class="mb-3">
                <label>Alumno:</label>
                <select class="form-control" @bind="nueva_matricula.i_alumno_id">
                    <option value="0">Seleccione un alumno...</option>
                    @if (lista_alumnos != null)
                    {
                        @foreach (var alu in lista_alumnos)
                        {
                            <option value="@alu.i_id">@alu.c_nombre @alu.c_apellido (@alu.c_identificacion)</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label>Materia:</label>
                <select class="form-control" @bind="nueva_matricula.i_materia_id">
                    <option value="0">Seleccione una materia...</option>
                    @if (lista_materias != null)
                    {
                        @foreach (var mat in lista_materias)
                        {
                            <option value="@mat.i_id">@mat.c_nombre (@mat.c_codigo)</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label>Año Académico:</label>
                <input type="number" class="form-control" @bind="nueva_matricula.i_anio_academico" />
            </div>

            <div class="mb-3">
                <label>Calificación Final (Opcional - Rango 0.0 a 5.0):</label>
                <input type="text" class="form-control" @bind="calificacion_texto" placeholder="Ej: 4.5" />
            </div>

            <button class="btn btn-primary" @onclick="guardar_matricula">Matricular Alumno</button>
        </div>
    </div>

    <h4>Listado de Matrículas</h4>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Alumno</th>
                <th>Materia</th>
                <th>Profesor Asignado</th>
                <th>Año</th>
                <th>Calificación Final</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in lista_matriculas)
            {
                <tr>
                    <td>@m.i_id</td>
                    <td>@(m.alumno != null ? $"{m.alumno.c_nombre} {m.alumno.c_apellido}" : m.i_alumno_id.ToString())</td>
                    <td>@(m.materia != null ? m.materia.c_nombre : m.i_materia_id.ToString())</td>
                    <td>@(m.profesor != null ? $"{m.profesor.c_nombre} {m.profesor.c_apellido}" : "No asignado")</td>
                    <td>@m.i_anio_academico</td>
                    <td>
                        <input type="number" step="0.01" min="0" max="5" class="form-control form-control-sm" style="width: 100px;" @bind="m.d_calificacion_final" />
                    </td>
                    <td>
                        <button class="btn btn-success btn-sm" @onclick="() => actualizar_calificacion(m.i_id, m.d_calificacion_final)">Guardar Nota</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<adm_colegio_front.Models.Matricula_dto>? lista_matriculas;
    private List<adm_colegio_front.Models.Persona_dto>? lista_alumnos;
    private List<adm_colegio_front.Models.Materia_dto>? lista_materias;
    private adm_colegio_front.Models.Matricula_dto nueva_matricula = new() { i_anio_academico = DateTime.Now.Year };
    private string calificacion_texto = string.Empty;
    private string mensaje_error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await cargar_datos();
    }

    private async Task cargar_datos()
    {
        lista_matriculas = await matricula_service.obtener_matriculas_async();
        var todas_personas = await persona_service.obtener_personas_async();
        lista_alumnos = todas_personas.Where(p => p.c_tipo_persona == "A").ToList();
        lista_materias = await materia_service.obtener_materias_async();
    }

    private async Task guardar_matricula()
    {
        mensaje_error = string.Empty;
        if (nueva_matricula.i_alumno_id == 0 || nueva_matricula.i_materia_id == 0)
        {
            mensaje_error = "Debe seleccionar un alumno y una materia válidos.";
            return;
        }

        // Si el campo de texto está vacío, asignamos un 0 por defecto (o el valor quemado que desees)
        if (string.IsNullOrWhiteSpace(calificacion_texto))
        {
            nueva_matricula.d_calificacion_final = 0.0m;
        }
        else
        {
            var textoLimpio = calificacion_texto.Replace('.', ',');
            if (decimal.TryParse(textoLimpio, out decimal notaParsed))
            {
                nueva_matricula.d_calificacion_final = notaParsed;
            }
            else
            {
                mensaje_error = "El formato de la calificación no es válido.";
                return;
            }
        }

        var (exito, mensaje) = await matricula_service.crear_matricula_async(nueva_matricula);
        if (exito)
        {
            nueva_matricula = new() { i_anio_academico = DateTime.Now.Year };
            calificacion_texto = string.Empty;
            await cargar_datos();
        }
        else
        {
            mensaje_error = mensaje;
        }
    }

    private async Task actualizar_calificacion(int id, decimal? nota)
    {
        mensaje_error = string.Empty;
        var (exito, mensaje) = await matricula_service.actualizar_calificacion_async(id, nota);
        if (exito)
        {
            await cargar_datos();
        }
        else
        {
            mensaje_error = mensaje;
        }
    }
}