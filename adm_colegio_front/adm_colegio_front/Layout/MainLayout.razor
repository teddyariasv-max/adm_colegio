@inherits LayoutComponentBase

<div class="d-flex" id="wrapper" style="min-height: 100vh; background-color: #f8fafc;">
    <!-- 1. Columna Izquierda: Menú Lateral -->
    <div class="border-end bg-white" id="sidebar-wrapper" style="width: 260px; box-shadow: 2px 0 10px rgba(0,0,0,0.04);">
        <!-- Encabezado del Menú en Rojo Académico -->
        <div class="sidebar-heading px-4 py-3 border-bottom d-flex align-items-center gap-2" style="background-color: #881337; color: #ffffff;">
            <i class="bi bi-mortarboard-fill fs-4"></i>
            <span class="fw-bold fs-6">Gestión Escolar</span>
        </div>
        <NavMenu />
    </div>

    <!-- 2. Columna Derecha: Encabezado + Contenido -->
    <div id="page-content-wrapper" class="flex-grow-1 d-flex flex-column">
        <!-- Barra Superior (Texto en gris oscuro #334155 para legibilidad) -->
        <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 py-2 shadow-sm">
            <div class="container-fluid p-0 d-flex justify-content-between align-items-center">
                <span class="fw-bold fs-6" style="color: #334155;">Sistema Académico v1.0</span>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light border py-2 px-3 fs-6" style="color: #1e293b; font-weight: 600;">
                        <i class="bi bi-person-circle me-1" style="color: #881337;"></i> Usuario Administrador
                    </span>
                </div>
            </div>
        </header>

        <!-- Área de Contenido Principal -->
        <main class="container-fluid p-4 flex-grow-1">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white" style="color: #1e293b;">
                @Body
            </div>
        </main>
    </div>
</div>