@page "/materias"

<PageTitle>Materias</PageTitle>

<h4 class="fw-bold text-danger mb-3">Gestión de Materias</h4>

<!-- Formulario Directo -->
<div class="card p-3 mb-3 bg-light">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" class="form-control" placeholder="Nombre de la materia" />
        </div>
        <div class="col-md-5">
            <input type="text" class="form-control" placeholder="Código de la asignatura" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-danger w-100 fw-bold">Guardar</button>
        </div>
    </div>
</div>

<!-- Tabla Directa -->
<table class="table table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Materia</th>
            <th class="text-center" style="width: 120px;">Eliminar</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>MAT-101</td>
            <td>Matemáticas</td>
            <td class="text-center">
                <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
            </td>
        </tr>
        <tr>
            <td>HIS-201</td>
            <td>Historia</td>
            <td class="text-center">
                <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
            </td>
        </tr>
    </tbody>
</table>