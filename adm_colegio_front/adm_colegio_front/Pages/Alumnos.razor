@page "/alumnos"
@using adm_colegio_front.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Alumnos</PageTitle>

<h4 class="fw-bold text-danger mb-3">Gestión de Alumnos</h4>

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="alert alert-danger p-2 mb-3">@errorMensaje</div>
}

<!-- Formulario Completo -->
<div class="card p-3 mb-3 bg-light">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" class="form-control" placeholder="Identificación" @bind="nuevoAlumno.c_identificacion" />
        </div>
        <div class="col-md-3">
            <input type="text" class="form-control" placeholder="Nombre" @bind="nuevoAlumno.c_nombre" />
        </div>
        <div class="col-md-3">
            <input type="text" class="form-control" placeholder="Apellido" @bind="nuevoAlumno.c_apellido" />
        </div>
        <div class="col-md-2">
            <input type="number" class="form-control" placeholder="Edad" @bind="nuevoAlumno.i_edad" />
        </div>
        <div class="col-md-1">
            <button class="btn btn-danger w-100 fw-bold" @onclick="GuardarAlumno">Guardar</button>
        </div>
    </div>
</div>

<!-- Tabla de Alumnos -->
@if (alumnos == null)
{
    <p><em>Cargando alumnos...</em></p>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Documento</th>
                <th>Nombres y Apellidos</th>
                <th>Edad</th>
                <th class="text-center" style="width: 120px;">Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alumno in alumnos)
            {
                <tr>
                    <td>@alumno.c_identificacion</td>
                    <td>@alumno.c_nombre @alumno.c_apellido</td>
                    <td>@alumno.i_edad</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-danger" @onclick="() => EliminarAlumno(alumno.i_id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Alumno>? alumnos;
    private Alumno nuevoAlumno = new Alumno { c_tipo_persona = "A" };
    private string errorMensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarAlumnos();
    }

    private async Task CargarAlumnos()
    {
        try
        {
            errorMensaje = string.Empty;
            var personas = await Http.GetFromJsonAsync<List<Alumno>>("api/personas");
            alumnos = personas?.Where(p => p.c_tipo_persona == "A").ToList() ?? new List<Alumno>();
        }
        catch (Exception ex)
        {
            alumnos = new List<Alumno>();
            errorMensaje = $"Error al cargar alumnos: {ex.Message}";
        }
    }

    private async Task GuardarAlumno()
    {
        try
        {
            errorMensaje = string.Empty;

            if (!string.IsNullOrWhiteSpace(nuevoAlumno.c_nombre) && !string.IsNullOrWhiteSpace(nuevoAlumno.c_identificacion))
            {
                nuevoAlumno.c_tipo_persona = "A";
                var respuesta = await Http.PostAsJsonAsync("api/personas", nuevoAlumno);

                if (respuesta.IsSuccessStatusCode)
                {
                    nuevoAlumno = new Alumno { c_tipo_persona = "A" };
                    await CargarAlumnos();
                }
                else
                {
                    var errorTexto = await respuesta.Content.ReadAsStringAsync();
                    errorMensaje = $"Error del servidor: {errorTexto}";
                }
            }
            else
            {
                errorMensaje = "El nombre y la identificación son obligatorios.";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al guardar: {ex.Message}";
        }
    }

    private async Task EliminarAlumno(int id)
    {
        try
        {
            var respuesta = await Http.DeleteAsync($"api/personas/{id}");
            if (!respuesta.IsSuccessStatusCode)
            {
                var errorBackend = await respuesta.Content.ReadAsStringAsync();
                errorMensaje = !string.IsNullOrEmpty(errorBackend) ? errorBackend : "No se pudo eliminar el alumno.";
            }
            await CargarAlumnos();
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al eliminar: {ex.Message}";
        }
    }
}