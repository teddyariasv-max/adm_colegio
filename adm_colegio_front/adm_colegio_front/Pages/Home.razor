@page "/"

<PageTitle>Inicio - Sistema Académico</PageTitle>

<div class="mb-4">
    <h4 class="fw-bold mb-1" style="color: #881337;">¡Bienvenido al Sistema Académico!</h4>
    <p class="text-muted small mb-0">Resumen general y accesos rápidos de la institución escolar.</p>
</div>

<!-- Se agrega modulos a pantalla de inicio -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-white" style="background-color: #881337;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Alumnos</div>
                    <div class="fs-3 fw-bold">--</div>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-secondary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Profesores</div>
                    <div class="fs-3 fw-bold">--</div>
                </div>
                <i class="bi bi-person-badge fs-1 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-dark text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Materias</div>
                    <div class="fs-3 fw-bold">--</div>
                </div>
                <i class="bi bi-book fs-1 opacity-50"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 border">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted">Calificaciones</div>
                    <div class="fs-3 fw-bold" style="color: #881337;">--</div>
                </div>
                <i class="bi bi-journal-check fs-1 text-muted opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Acceso Rápido a Módulos -->
<h6 class="fw-bold mb-3" style="color: #1e293b;">Módulos Disponibles</h6>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card border h-100 shadow-sm rounded-3 p-3">
            <div class="d-flex align-items-start gap-3">
                <div class="p-3 rounded-3" style="background-color: #ffe4e6; color: #881337;">
                    <i class="bi bi-file-earmark-bar-graph fs-3"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1" style="color: #1e293b;">Reporte Consolidado</h6>
                    <p class="text-muted small mb-2">Consulta detallada de notas por alumno, materia y profesor.</p>
                    <a href="reporte-consolidado" class="btn btn-sm text-white" style="background-color: #881337;">
                        Ver Reporte
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>